---
import CrossStitch from "./CrossStitch.astro";
import CaptionBar from "./CaptionBar";
import { captions, site } from "@data/site";
---

<section id="top" class="hero" aria-labelledby="hero-title">
  <div class="container hero-grid">
    <div class="hero-copy">
      <p class="status mono">
        <span class="dot" aria-hidden="true"></span> on-call & operational
      </p>
      <h1 id="hero-title">
        Hi, I'm <em>Megan</em>
      </h1>
      <p class="tagline">
        A <mark>backend software engineer</mark> keeping live captions running for a global customer
        base. Previously a computational biochemist. Forever a crafter.
      </p>
      <div class="ctas">
        <a class="btn btn--primary" href="#experience">
          See my work
        </a>
        <a class="btn" href={site.resume} target="_blank" rel="noopener">
          Resume ↗
        </a>
        <a class="btn" href="#contact">
          Say hi
        </a>
      </div>
    </div>

    <div class="hoop" aria-hidden="true">
      <div class="hoop-inner">
        <CrossStitch pattern="avatar" class="avatar" />
      </div>
      <span class="hoop-screw"></span>
      <CrossStitch pattern="heart" class="sticker sticker-heart" />
      <CrossStitch pattern="strawberry" class="sticker sticker-berry" />
    </div>
  </div>

  <div class="container">
    <CaptionBar client:load lines={captions} />
  </div>
</section>

<style>
  .hero {
    overflow-x: clip;
    padding-block: clamp(2.5rem, 2rem + 4vw, 5.5rem) var(--space-4);
  }

  .hero-grid {
    display: grid;
    gap: var(--space-7);
    align-items: center;
  }

  .status {
    display: inline-flex;
    align-items: center;
    gap: var(--space-2);
    margin-bottom: var(--space-4);
    padding: 0.35em 0.9em;
    border-radius: var(--radius-pill);
    background: var(--color-surface);
    border: 1.5px solid var(--color-border);
    font-size: var(--text-xs);
  }

  .dot {
    width: 0.6rem;
    height: 0.6rem;
    border-radius: 50%;
    background: var(--thread-sage);
    box-shadow: 0 0 0 0 var(--thread-sage);
    animation: pulse 2s ease-out infinite;
  }

  @keyframes pulse {
    to {
      box-shadow: 0 0 0 0.5rem transparent;
    }
  }

  h1 {
    font-size: var(--text-2xl);
    line-height: 0.95;
  }

  .tagline {
    max-width: 34rem;
    margin-top: var(--space-5);
    font-size: var(--text-lg);
    color: var(--color-ink-soft);
  }

  mark {
    padding: 0 0.2em;
    background: linear-gradient(
      transparent 55%,
      color-mix(in srgb, var(--thread-rose) 55%, transparent) 55%
    );
    color: var(--color-ink);
    font-weight: 600;
  }

  .ctas {
    display: flex;
    flex-wrap: wrap;
    gap: var(--space-3);
    margin-top: var(--space-6);
  }

  /* Embroidery hoop holding the stitched avatar */
  .hoop {
    position: relative;
    width: min(100%, 22rem);
    margin-inline: auto;
    aspect-ratio: 1;
  }

  .hoop-inner {
    display: grid;
    place-items: center;
    width: 100%;
    height: 100%;
    border-radius: 50%;
    border: 12px solid var(--color-wood);
    outline: 4px solid var(--color-wood-dark);
    outline-offset: -4px;
    background:
      linear-gradient(var(--color-bg-grid) 1px, transparent 1px) 0 0 / 10px 10px,
      linear-gradient(90deg, var(--color-bg-grid) 1px, transparent 1px) 0 0 / 10px 10px,
      var(--color-surface);
    box-shadow: var(--shadow-card);
  }

  .hoop :global(.avatar) {
    width: 58%;
  }

  .hoop-screw {
    position: absolute;
    top: -14px;
    left: 50%;
    width: 2.2rem;
    height: 1.4rem;
    translate: -50% 0;
    border-radius: 6px;
    background: var(--color-wood-dark);
  }

  .hoop :global(.sticker) {
    position: absolute;
    width: 22%;
    filter: drop-shadow(0 4px 6px rgb(0 0 0 / 0.15));
    animation: bob 4s ease-in-out infinite;
  }

  .hoop :global(.sticker-heart) {
    right: -4%;
    top: 12%;
  }

  .hoop :global(.sticker-berry) {
    left: -2%;
    bottom: 6%;
    animation-delay: -2s;
  }

  @keyframes bob {
    50% {
      transform: translateY(-8px) rotate(-4deg);
    }
  }

  /* ---- Caption bar (React island) ---- */
  .hero :global(.caption-bar) {
    display: flex;
    align-items: flex-start;
    gap: var(--space-3);
    margin: var(--space-7) 0 0;
    padding: var(--space-4) var(--space-5);
    border-radius: var(--radius-sm);
    background: var(--color-caption-bg);
    color: var(--color-caption-ink);
    font-family: var(--font-mono);
    font-size: clamp(0.85rem, 0.8rem + 0.35vw, 1.05rem);
    line-height: 1.5;
    box-shadow: var(--shadow-card);
    min-height: 4.6rem;
  }

  .hero :global(.caption-badge) {
    flex: none;
    padding: 0.1em 0.45em;
    border: 1.5px solid currentColor;
    border-radius: 4px;
    font-size: 0.75em;
    font-weight: 700;
    letter-spacing: 0.05em;
    margin-top: 0.2em;
  }

  .hero :global(.caption-speaker) {
    color: var(--thread-rose);
    font-weight: 700;
  }

  .hero :global(.caption-cue) {
    color: #bccb98;
    font-style: italic;
  }

  .hero :global(.caption-cursor) {
    display: inline-block;
    width: 0.55em;
    height: 1.1em;
    margin-left: 2px;
    vertical-align: text-bottom;
    background: currentColor;
    animation: blink 1s steps(1) infinite;
  }

  @keyframes blink {
    50% {
      opacity: 0;
    }
  }

  @media (min-width: 52rem) {
    .hero-grid {
      grid-template-columns: 1.25fr 1fr;
    }
  }
</style>
