---
import Section from "./Section.astro";
import { site } from "@data/site";

const links = [
  { label: "LinkedIn", value: "in/megan-chang", href: site.links.linkedin },
  { label: "GitHub", value: "megan-chang", href: site.links.github },
  { label: "Resume", value: "PDF, one page", href: site.resume },
];
---

<Section
  id="contact"
  eyebrow="08 / open a ticket"
  title="Say hi"
  intro="Hiring, looking to collaborate, or just want to talk about captions, backend systems, or cross-stitch patterns? My inbox is open."
>
  <ul class="links">
    <li>
      <!-- Email copies to the clipboard instead of opening a mail app -->
      <button type="button" class="card contact copy-email" data-email={site.email}>
        <span>
          <span class="label">Email</span>
          <span class="value mono">{site.email}</span>
        </span>
        <span class="copy-hint mono" aria-hidden="true">
          copy
        </span>
      </button>
      <p class="sr-only" role="status" aria-live="polite" id="copy-status"></p>
    </li>
    {links.map((link) => {
      const external = link.href.startsWith("http") || link.href.endsWith(".pdf");
      return (
        <li>
          <a
            class="card contact"
            href={link.href}
            target={external ? "_blank" : undefined}
            rel={external ? "noopener" : undefined}
          >
            <span>
              <span class="label">{link.label}</span>
              <span class="value mono">{link.value}</span>
            </span>
            <span class="arrow" aria-hidden="true">
              ↗
            </span>
          </a>
        </li>
      );
    })}
  </ul>
</Section>

<script>
  const button = document.querySelector<HTMLButtonElement>(".copy-email");
  const hint = button?.querySelector<HTMLElement>(".copy-hint");
  const status = document.querySelector<HTMLElement>("#copy-status");

  async function copy(text: string): Promise<boolean> {
    try {
      await navigator.clipboard.writeText(text);
      return true;
    } catch {
      return false;
    }
  }

  // If clipboard access is blocked, highlight the address so it can be copied by hand.
  function selectEmail() {
    const value = button?.querySelector(".value");
    const selection = window.getSelection();
    if (!value || !selection) return;
    const range = document.createRange();
    range.selectNodeContents(value);
    selection.removeAllRanges();
    selection.addRange(range);
  }

  let reset: ReturnType<typeof setTimeout> | undefined;

  button?.addEventListener("click", async () => {
    const email = button.dataset.email ?? "";
    const copied = await copy(email);
    if (!copied) selectEmail();
    if (hint) hint.textContent = copied ? "copied!" : "press ⌘C";
    if (status) {
      status.textContent = copied
        ? `${email} copied to clipboard`
        : `Couldn't copy automatically. ${email} is selected.`;
    }
    button.classList.toggle("is-copied", copied);

    clearTimeout(reset);
    reset = setTimeout(() => {
      if (hint) hint.textContent = "copy";
      if (status) status.textContent = "";
      button.classList.remove("is-copied");
    }, 2000);
  });
</script>

<style>
  .links {
    display: grid;
    grid-template-columns: repeat(auto-fit, minmax(min(100%, 15rem), 1fr));
    gap: var(--space-4);
    list-style: none;
  }

  /* The email card gets extra room so the address fits on one line next to its pill */
  @media (min-width: 60rem) {
    .links {
      grid-template-columns: 1.6fr repeat(3, 1fr);
    }
  }

  .contact {
    width: 100%;
    display: flex;
    align-items: center;
    justify-content: space-between;
    gap: var(--space-4);
    padding: var(--space-4) var(--space-5);
    border-width: 2px;
    border-color: var(--color-ink);
    box-shadow: 4px 4px 0 var(--color-ink);
    transition:
      transform 0.15s ease,
      box-shadow 0.15s ease;
  }

  .contact:hover {
    transform: translate(-2px, -2px);
    box-shadow: 6px 6px 0 var(--color-fill);
  }

  .copy-email {
    font: inherit;
    color: inherit;
    text-align: left;
    cursor: pointer;
  }

  .copy-hint {
    flex: none;
    font-size: var(--text-xs);
    font-weight: 600;
    padding: 0.25em 0.75em;
    border: 1.5px dashed var(--color-ink-soft);
    border-radius: var(--radius-pill);
    color: var(--color-ink-soft);
    transition:
      background-color 0.15s ease,
      color 0.15s ease;
  }

  .copy-email:hover .copy-hint {
    border-color: var(--color-accent);
    color: var(--color-accent);
  }

  .copy-email.is-copied .copy-hint,
  .copy-email.is-copied:hover .copy-hint {
    border-style: solid;
    background: var(--color-fill);
    border-color: var(--color-fill);
    color: var(--color-on-fill);
  }

  .arrow {
    font-size: 1.25rem;
    color: var(--color-ink-soft);
    transition: transform 0.15s ease;
  }

  .contact:hover .arrow {
    transform: translate(2px, -2px);
    color: var(--color-accent);
  }

  .label {
    display: block;
    font-weight: 600;
  }

  .value {
    display: block;
    font-size: var(--text-xs);
    color: var(--color-ink-soft);
    overflow-wrap: anywhere;
  }
</style>
