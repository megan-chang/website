---
import Section from "./Section.astro";
import { site } from "@data/site";

const links = [
  { label: "Email", value: site.email, href: `mailto:${site.email}` },
  { label: "LinkedIn", value: "in/megan-chang", href: site.links.linkedin },
  { label: "GitHub", value: "megan-chang", href: site.links.github },
  { label: "Resume", value: "PDF, one page", href: site.resume },
];
---

<Section
  id="contact"
  eyebrow="08 / open a ticket"
  title="Say hi"
  intro="Hiring, collaborating, or just want to talk about captions, backend systems, or cross-stitch patterns? My inbox is open."
>
  <ul class="links">
    {
      links.map((link) => {
        const external = link.href.startsWith("http") || link.href.endsWith(".pdf");
        return (
          <li>
            <a
              class="card contact"
              href={link.href}
              target={external ? "_blank" : undefined}
              rel={external ? "noopener" : undefined}
            >
              <span>
                <span class="label">{link.label}</span>
                <span class="value mono">{link.value}</span>
              </span>
              <span class="arrow" aria-hidden="true">
                ↗
              </span>
            </a>
          </li>
        );
      })
    }
  </ul>
</Section>

<style>
  .links {
    display: grid;
    grid-template-columns: repeat(auto-fit, minmax(min(100%, 15rem), 1fr));
    gap: var(--space-4);
    list-style: none;
  }

  .contact {
    display: flex;
    align-items: center;
    justify-content: space-between;
    gap: var(--space-4);
    padding: var(--space-4) var(--space-5);
    border-width: 2px;
    border-color: var(--color-ink);
    box-shadow: 4px 4px 0 var(--color-ink);
    transition:
      transform 0.15s ease,
      box-shadow 0.15s ease;
  }

  .contact:hover {
    transform: translate(-2px, -2px);
    box-shadow: 6px 6px 0 var(--color-fill);
  }

  .arrow {
    font-size: 1.25rem;
    color: var(--color-ink-soft);
    transition: transform 0.15s ease;
  }

  .contact:hover .arrow {
    transform: translate(2px, -2px);
    color: var(--color-accent);
  }

  .label {
    display: block;
    font-weight: 600;
  }

  .value {
    display: block;
    font-size: var(--text-xs);
    color: var(--color-ink-soft);
    overflow-wrap: anywhere;
  }
</style>
