---
import { Picture } from "astro:assets";
import Section from "./Section.astro";
import { education, publications } from "@data/publications";
---

<Section
  id="research"
  eyebrow="06 / research"
  title="Research roots"
  intro="Before backend, I simulated disordered proteins. Turns out wrangling messy, dynamic systems is great practice for production."
>
  <div class="research-grid">
    <figure class="card protein">
      <!-- A still by default; the 3 MB animation only loads when someone runs the simulation -->
      <div class="dish">
        <img
          id="protein"
          src="/media/protein-still.webp"
          data-animated="/media/protein-animated.webp"
          alt="Molecular dynamics render of the Nrf2 Neh4 domain: green helices with blue loops"
          width="640"
          height="640"
          loading="lazy"
          decoding="async"
        />
      </div>
      <figcaption>
        <span class="mono">Nrf2 Neh4, in silico</span>
        <button type="button" id="run-sim" class="run mono" aria-pressed="false">
          ▶ run simulation
        </button>
      </figcaption>
    </figure>

    <div class="side">
      <ul class="degrees">
        {
          education.map((item) => (
            <li class="card">
              <div>
                <p class="degree">{item.degree}</p>
                <p class="school">
                  {item.school} · {item.years}
                </p>
              </div>
            </li>
          ))
        }
      </ul>

      <ul class="papers">
        {
          publications.map((paper) => (
            <li>
              <a class="card paper" href={paper.url} target="_blank" rel="noopener">
                <Picture
                  src={paper.image}
                  alt={paper.imageAlt}
                  widths={[160, 320]}
                  sizes="7rem"
                  formats={["avif", "webp"]}
                  class="thumb"
                />
                <div>
                  <p class="venue mono">
                    {paper.venue} · {paper.year}
                  </p>
                  <p class="paper-title">{paper.title}</p>
                  <p class="authors">{paper.authors}</p>
                </div>
              </a>
            </li>
          ))
        }
      </ul>
    </div>
  </div>
</Section>

<script>
  const button = document.querySelector<HTMLButtonElement>("#run-sim");
  const protein = document.querySelector<HTMLImageElement>("#protein");

  if (button && protein) {
    const still = protein.src;
    const animated = protein.dataset.animated ?? still;

    button.addEventListener("click", () => {
      const running = button.getAttribute("aria-pressed") !== "true";
      protein.src = running ? animated : still;
      button.setAttribute("aria-pressed", String(running));
      button.textContent = running ? "■ stop simulation" : "▶ run simulation";
    });
  }
</script>

<style>
  .research-grid {
    display: grid;
    gap: var(--space-5);
    align-items: start;
  }

  .protein {
    margin: 0;
    padding: var(--space-5);
  }

  /* A petri dish: always light, so the dark green helices read in both themes */
  .dish {
    padding: 8%;
    border-radius: 50%;
    background: radial-gradient(circle at 35% 30%, #fffdf8, #f5efe4 60%, #e6dccb);
    box-shadow:
      inset 0 0 0 6px rgb(255 255 255 / 0.7),
      inset 0 0 0 7px #d9cdb8,
      0 10px 24px -14px rgb(0 0 0 / 0.4);
  }

  .dish img {
    width: 100%;
    aspect-ratio: 1;
    object-fit: contain;
  }

  figcaption {
    display: flex;
    flex-wrap: wrap;
    align-items: center;
    justify-content: space-between;
    gap: var(--space-2);
    margin-top: var(--space-4);
    font-size: var(--text-xs);
    color: var(--color-ink-soft);
  }

  .run {
    padding: 0.45em 0.9em;
    border: 1.5px solid var(--color-accent-3);
    border-radius: var(--radius-pill);
    background: transparent;
    color: var(--color-accent-3);
    font-size: var(--text-xs);
    font-weight: 700;
    cursor: pointer;
  }

  .run:hover,
  .run[aria-pressed="true"] {
    background: var(--color-ink);
    color: var(--color-bg);
  }

  .side {
    display: grid;
    gap: var(--space-4);
  }

  .degrees,
  .papers {
    display: grid;
    gap: var(--space-3);
    list-style: none;
  }

  .degrees li {
    display: flex;
    align-items: center;
    gap: var(--space-3);
    padding: var(--space-3) var(--space-4);
  }

  .degree {
    font-weight: 600;
  }

  .school {
    font-size: var(--text-sm);
    color: var(--color-ink-soft);
  }

  .paper {
    display: grid;
    grid-template-columns: 6rem 1fr;
    gap: var(--space-4);
    align-items: center;
    padding: var(--space-3);
    transition:
      transform 0.2s ease,
      border-color 0.2s ease;
  }

  .paper:hover {
    transform: translateY(-3px);
    border-color: var(--color-accent-3);
  }

  .paper :global(.thumb) {
    width: 100%;
    aspect-ratio: 1;
    object-fit: cover;
    border-radius: var(--radius-sm);
    background: white;
  }

  .venue {
    font-size: 0.75rem;
    color: var(--color-accent-3);
  }

  .paper-title {
    margin-top: var(--space-1);
    font-weight: 600;
    font-size: var(--text-sm);
    line-height: 1.35;
  }

  .authors {
    margin-top: var(--space-1);
    font-size: var(--text-xs);
    color: var(--color-ink-soft);
  }

  @media (min-width: 52rem) {
    .research-grid {
      grid-template-columns: 1fr 1.4fr;
    }
  }
</style>
