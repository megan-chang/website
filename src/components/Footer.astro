---
import CrossStitch from "./CrossStitch.astro";

const year = new Date().getFullYear();
---

<footer class="footer">
  <div class="container inner">
    <div class="stitch-row" aria-hidden="true">
      <CrossStitch pattern="heart" />
    </div>
    <p class="status mono">
      <span class="dot" aria-hidden="true"></span> status: all systems operational
    </p>
    <p class="small">
      © {year} Megan Chang · Built with Astro and a lot of thread ·
      <a
        class="stitch-link"
        href="https://github.com/megan-chang/website"
        target="_blank"
        rel="noopener"
      >
        view source
      </a>
    </p>
  </div>
</footer>

<style>
  .footer {
    margin-top: var(--space-8);
    padding-block: var(--space-6) calc(var(--space-6) + env(safe-area-inset-bottom, 0px));
    border-top: 1.5px dashed var(--color-border);
    text-align: center;
  }

  .inner {
    display: grid;
    justify-items: center;
    gap: var(--space-3);
  }

  .stitch-row {
    width: 2rem;
  }

  .status {
    display: inline-flex;
    align-items: center;
    gap: var(--space-2);
    font-size: var(--text-xs);
    color: var(--color-accent-2);
  }

  .dot {
    width: 0.55rem;
    height: 0.55rem;
    border-radius: 50%;
    background: var(--thread-sage);
  }

  .small {
    font-size: var(--text-xs);
    color: var(--color-ink-soft);
  }
</style>
