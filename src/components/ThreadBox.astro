---
import Section from "./Section.astro";
import { skillGroups } from "@data/skills";
---

<Section
  id="skills"
  eyebrow="05 / thread box"
  title="What I work with"
  intro="Sorted by colour, like any good floss organizer."
>
  <div class="box">
    {skillGroups.map((group) => (
      <section class="card compartment" style={`--thread: var(--thread-${group.color})`}>
        <header>
          {/* A skein: twisted thread with a paper band around the middle */}
          <span class="skein" aria-hidden="true">
            <span class="band" />
          </span>
          <div>
            <h3>{group.name}</h3>
            {group.note && <p class="note">{group.note}</p>}
          </div>
        </header>
        <ul>
          {group.skills.map((skill) => (
            <li>{skill}</li>
          ))}
        </ul>
      </section>
    ))}
  </div>
</Section>

<style>
  .box {
    display: grid;
    grid-template-columns: repeat(auto-fit, minmax(min(100%, 24rem), 1fr));
    gap: var(--space-4);
    padding: var(--space-4);
    border-radius: var(--radius-lg);
    background: var(--color-surface-2);
    border: 1.5px solid var(--color-border);
  }

  .compartment {
    padding: var(--space-5);
    border-top: 6px solid var(--thread);
  }

  header {
    display: flex;
    align-items: center;
    gap: var(--space-3);
    margin-bottom: var(--space-4);
  }

  .skein {
    position: relative;
    flex: none;
    width: 2.6rem;
    height: 1.3rem;
    border-radius: var(--radius-pill);
    background: repeating-linear-gradient(
      -55deg,
      var(--thread) 0 3px,
      color-mix(in srgb, var(--thread) 70%, white) 3px 5px
    );
  }

  .band {
    position: absolute;
    inset: -2px 0.85rem;
    border-radius: 2px;
    background: var(--color-surface);
    border: 1px solid var(--color-border);
  }

  h3 {
    font-size: 1.15rem;
  }

  .note {
    font-size: var(--text-xs);
    color: var(--color-ink-soft);
    font-style: italic;
  }

  ul {
    display: flex;
    flex-wrap: wrap;
    gap: var(--space-2);
    list-style: none;
  }

  li {
    padding: 0.3em 0.8em;
    border: 1.5px dashed var(--thread);
    border-radius: var(--radius-pill);
    font-size: var(--text-sm);
    font-weight: 500;
    transition: background-color 0.2s ease;
  }

  li:hover {
    background: color-mix(in srgb, var(--thread) 18%, transparent);
  }
</style>
