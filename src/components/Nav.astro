---
import CrossStitch from "./CrossStitch.astro";
import ThemeToggle from "./ThemeToggle";
import { nav } from "@data/site";
---

<header class="nav-wrap">
  <nav class="nav container" aria-label="Main">
    <a href="#top" class="brand" aria-label="Megan Chang, back to top">
      <CrossStitch pattern="monogram" class="brand-mark" />
      <span class="brand-name">megan chang</span>
    </a>

    <ul class="links">
      {
        nav.map((item) => (
          <li>
            <a class="stitch-link" href={item.href}>
              {item.label}
            </a>
          </li>
        ))
      }
    </ul>

    <div class="actions">
      <ThemeToggle client:load />
      <details class="menu">
        <summary aria-label="Menu">
          <span aria-hidden="true">menu</span>
        </summary>
        <ul class="menu-list card">
          {
            nav.map((item) => (
              <li>
                <a href={item.href}>{item.label}</a>
              </li>
            ))
          }
        </ul>
      </details>
    </div>
  </nav>
</header>

<script>
  // Close the mobile menu after picking a link.
  document.querySelectorAll<HTMLAnchorElement>(".menu-list a").forEach((link) => {
    link.addEventListener("click", () => link.closest("details")?.removeAttribute("open"));
  });
</script>

<style>
  .nav-wrap {
    position: sticky;
    top: 0;
    z-index: 50;
    padding-top: env(safe-area-inset-top, 0px);
    background: color-mix(in srgb, var(--color-bg) 82%, transparent);
    backdrop-filter: blur(10px);
    -webkit-backdrop-filter: blur(10px);
    border-bottom: 1.5px dashed var(--color-border);
  }

  .nav {
    display: flex;
    align-items: center;
    justify-content: space-between;
    gap: var(--space-4);
    min-height: 4rem;
  }

  .brand {
    display: flex;
    align-items: center;
    gap: var(--space-2);
    font-family: var(--font-display);
    font-size: 1.5rem;
    letter-spacing: -0.01em;
  }

  .brand :global(.brand-mark) {
    width: 2rem;
  }

  .brand :global(.brand-mark g) {
    stroke: var(--color-accent);
    transition: transform 0.3s ease;
  }

  .brand:hover :global(.brand-mark) {
    transform: rotate(-8deg) scale(1.08);
  }

  .links {
    display: none;
    list-style: none;
    gap: var(--space-5);
    font-size: var(--text-sm);
    font-weight: 500;
  }

  .actions {
    display: flex;
    align-items: center;
    gap: var(--space-2);
  }

  .actions :global(.theme-toggle) {
    display: inline-flex;
    align-items: center;
    gap: var(--space-2);
    padding: 0.4em 0.85em;
    border: 1.5px solid var(--color-border);
    border-radius: var(--radius-pill);
    background: var(--color-surface);
    color: var(--color-ink);
    font: 500 var(--text-xs) / 1 var(--font-mono);
    cursor: pointer;
    transition: border-color 0.2s ease;
  }

  .actions :global(.theme-toggle:hover) {
    border-color: var(--color-accent);
  }

  .menu {
    position: relative;
  }

  .menu summary {
    list-style: none;
    padding: 0.4em 0.85em;
    border: 1.5px solid var(--color-ink);
    border-radius: var(--radius-pill);
    font: 500 var(--text-xs) / 1 var(--font-mono);
    cursor: pointer;
  }

  .menu summary::-webkit-details-marker {
    display: none;
  }

  .menu-list {
    position: absolute;
    right: 0;
    top: calc(100% + var(--space-2));
    min-width: 11rem;
    padding: var(--space-2);
    list-style: none;
  }

  .menu-list a {
    display: block;
    padding: var(--space-2) var(--space-3);
    border-radius: var(--radius-sm);
  }

  .menu-list a:hover {
    background: var(--color-surface-2);
  }

  @media (max-width: 30rem) {
    .actions :global(.theme-toggle-label) {
      display: none;
    }
  }

  @media (min-width: 60rem) {
    .links {
      display: flex;
    }

    .menu {
      display: none;
    }
  }
</style>
