---
import { patterns, threadVar, type PatternName } from "@data/patterns";

interface Props {
  pattern: PatternName;
  /** Accessible description. Omit for purely decorative stitches. */
  label?: string;
  /** Pattern letters whose stitches get a solid backing, so an area reads as filled (e.g. "W"). */
  backing?: string;
  class?: string;
}

const { pattern, label, backing = "", class: className } = Astro.props;
const rows = patterns[pattern];
const cell = 10;
const inset = 2;
const width = Math.max(...rows.map((row) => row.length));

// Each stitch is two crossing strokes, the "/" laid first and the "\" on top.
const stitches = rows.flatMap((row, y) =>
  [...row].flatMap((char, x) => {
    const color = threadVar[char.toUpperCase()];
    if (!color) return [];
    return [
      {
        x: x * cell,
        y: y * cell,
        color,
        planned: char !== char.toUpperCase(),
        backed: backing.includes(char),
      },
    ];
  }),
);
---

<svg
  class:list={["cross-stitch", className]}
  viewBox={`0 0 ${width * cell} ${rows.length * cell}`}
  role={label ? "img" : undefined}
  aria-label={label}
  aria-hidden={label ? undefined : "true"}
>
  {stitches
    .filter((s) => s.backed)
    .map(({ x, y, color }) => (
      <rect x={x} y={y} width={cell} height={cell} fill={color} class="backing" />
    ))}
  {stitches.map(({ x, y, color, planned }) => (
    <g stroke={color} opacity={planned ? 0.22 : 1}>
      <line x1={x + inset} y1={y + cell - inset} x2={x + cell - inset} y2={y + inset} />
      <line x1={x + inset} y1={y + inset} x2={x + cell - inset} y2={y + cell - inset} class="top" />
    </g>
  ))}
</svg>

<style>
  .cross-stitch {
    width: 100%;
    height: auto;
    overflow: visible;
    stroke-width: 2.6;
    stroke-linecap: round;
  }

  /* Slightly translucent so the stitch texture still shows through */
  .backing {
    opacity: 0.85;
  }

  /* The top thread catches a little light */
  .top {
    filter: brightness(1.12);
  }
</style>
